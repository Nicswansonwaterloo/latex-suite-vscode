{
  "name": "latex-suite-vscode",
  "displayName": "LaTeX Suite for VSCode",
  "description": "Fast LaTeX math typing in Markdown and LaTeX: auto-expanding snippets, auto-fractions, matrix shortcuts, and Tab navigation. A port of Obsidian LaTeX Suite.",
  "version": "1.1.0",
  "publisher": "qmvis",
  "license": "MIT",
  "icon": "assets/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nicswansonwaterloo/latex-suite-vscode.git"
  },
  "homepage": "https://github.com/Nicswansonwaterloo/latex-suite-vscode#readme",
  "bugs": {
    "url": "https://github.com/Nicswansonwaterloo/latex-suite-vscode/issues"
  },
  "galleryBanner": {
    "color": "#ffffff",
    "theme": "light"
  },
  "engines": {
    "vscode": "^1.137.0",
    "node": ">=24"
  },
  "categories": [
    "Snippets",
    "Other"
  ],
  "keywords": [
    "latex",
    "markdown",
    "math",
    "snippets",
    "obsidian"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Built-in snippets remain available. Custom snippet source and files are disabled because snippet files execute JavaScript.",
      "restrictedConfigurations": [
        "latexSuite.snippets.source",
        "latexSuite.snippets.files",
        "latexSuite.snippets.variablesSource",
        "latexSuite.snippets.variableFiles"
      ]
    },
    "virtualWorkspaces": {
      "supported": true,
      "description": "Built-in and self-contained snippets work in virtual workspaces. Relative Node.js imports from virtual snippet files are not supported."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "latexSuite.addSnippetFile",
        "category": "LaTeX Suite",
        "title": "Add Snippet File\u2026"
      },
      {
        "command": "latexSuite.addVariableFile",
        "category": "LaTeX Suite",
        "title": "Add Variable File\u2026"
      },
      {
        "command": "latexSuite.expandSnippet",
        "category": "LaTeX Suite",
        "title": "Expand Snippet"
      },
      {
        "command": "latexSuite.expandSnippetByKey",
        "category": "LaTeX Suite",
        "title": "Expand Snippet by Trigger Key"
      },
      {
        "command": "latexSuite.autoFraction",
        "category": "LaTeX Suite",
        "title": "Insert Auto-fraction"
      },
      {
        "command": "latexSuite.nextBracketOrEquation",
        "category": "LaTeX Suite",
        "title": "Move to Next Bracket or Exit Equation"
      },
      {
        "command": "latexSuite.matrixCell",
        "category": "LaTeX Suite",
        "title": "Add Matrix Cell"
      },
      {
        "command": "latexSuite.matrixNewline",
        "category": "LaTeX Suite",
        "title": "Add Matrix Row"
      },
      {
        "command": "latexSuite.matrixExit",
        "category": "LaTeX Suite",
        "title": "Exit Matrix"
      },
      {
        "command": "latexSuite.reloadSnippets",
        "category": "LaTeX Suite",
        "title": "Reload Snippets"
      },
      {
        "command": "latexSuite.toggleEnabled",
        "category": "LaTeX Suite",
        "title": "Toggle Typing Shortcuts"
      },
      {
        "command": "latexSuite.openSettings",
        "category": "LaTeX Suite",
        "title": "Open Settings"
      },
      {
        "command": "latexSuite.tab",
        "category": "LaTeX Suite",
        "title": "Contextual Tab"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "latexSuite.tab",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "latexSuite.tab",
        "key": "tab",
        "when": "editorTextFocus && !editorReadonly && !editorHasSelection && !editorHasMultipleSelections && !inSnippetMode && !suggestWidgetVisible && !inlineSuggestionVisible && !inlineEditIsVisible && !renameInputVisible && !editorTabMovesFocus && config.editor.tabCompletion == off && config.latexSuite.enabled && latexSuite.supportedDocument"
      },
      {
        "command": "latexSuite.internal.matrixNewline",
        "key": "enter",
        "when": "editorTextFocus && !editorReadonly && !editorHasSelection && !editorHasMultipleSelections && !suggestWidgetVisible && !inlineSuggestionVisible && !inlineEditIsVisible && !renameInputVisible && latexSuite.inMatrix && config.latexSuite.enabled && config.latexSuite.matrixShortcuts.enabled && latexSuite.supportedDocument"
      },
      {
        "command": "latexSuite.internal.matrixExit",
        "key": "shift+enter",
        "when": "editorTextFocus && !editorReadonly && !editorHasSelection && !editorHasMultipleSelections && !suggestWidgetVisible && !inlineSuggestionVisible && !inlineEditIsVisible && !renameInputVisible && latexSuite.inMatrix && config.latexSuite.enabled && config.latexSuite.matrixShortcuts.enabled && latexSuite.supportedDocument"
      }
    ],
    "configuration": {
      "title": "LaTeX Suite",
      "properties": {
        "latexSuite.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "order": 1,
          "markdownDescription": "Enable LaTeX Suite typing shortcuts in configured file types."
        },
        "latexSuite.snippets.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "order": 10,
          "markdownDescription": "Expand snippets, both automatically and with `Tab`."
        },
        "latexSuite.snippets.files": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "resource",
          "order": 12,
          "markdownDescription": "Snippet files or folders to load. Any custom snippets replace the bundled set. Relative paths resolve against the workspace folder.\n\nSnippet files are JavaScript and run as code. Only add files you trust."
        },
        "latexSuite.snippets.source": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "order": 13,
          "markdownDescription": "Snippets written inline, in the same JavaScript format as snippet files. Any custom snippets replace the bundled set; enter `[]` to turn off all snippets. Snippet files are easier to maintain for larger collections.",
          "editPresentation": "multilineText"
        },
        "latexSuite.snippets.variableFiles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "resource",
          "order": 14,
          "markdownDescription": "JavaScript files that export snippet variables. These are added to the bundled variables and override any with the same name. Relative paths resolve against the workspace folder."
        },
        "latexSuite.snippets.variablesSource": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "order": 15,
          "markdownDescription": "Snippet variables written inline as a JavaScript object. These are added to the bundled variables and override any with the same name.",
          "editPresentation": "multilineText"
        },
        "latexSuite.snippets.recursionLimit": {
          "type": "integer",
          "default": 0,
          "minimum": 0,
          "maximum": 10,
          "scope": "resource",
          "order": 16,
          "markdownDescription": "How many more times automatic snippets may expand on text that a snippet just inserted. `0` turns this off."
        },
        "latexSuite.snippets.wordDelimiters": {
          "type": "string",
          "default": "., +-\\n\\t:;!?\\/{}[]()=~$'\"|`<>*^%#@&",
          "scope": "resource",
          "order": 17,
          "markdownDescription": "Characters that count as word boundaries for snippets with the `w` option. Write `\\n` and `\\t` for newline and tab."
        },
        "latexSuite.snippets.removeTrailingWhitespace": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "order": 18,
          "markdownDescription": "Remove trailing spaces from snippet output in inline math."
        },
        "latexSuite.forceMathLanguages": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "math"
          ],
          "scope": "resource",
          "order": 20,
          "markdownDescription": "Markdown code-fence languages whose contents are treated as display math."
        },
        "latexSuite.autoFraction.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "order": 30,
          "markdownDescription": "Typing `/` in math turns the preceding expression, or the selection, into a fraction."
        },
        "latexSuite.autoFraction.symbol": {
          "type": "string",
          "default": "\\frac",
          "scope": "resource",
          "order": 31,
          "markdownDescription": "Command inserted by auto-fraction, such as `\\frac` or `\\dfrac`."
        },
        "latexSuite.autoFraction.breakingCharacters": {
          "type": "string",
          "default": "+-=\\t",
          "scope": "resource",
          "order": 32,
          "markdownDescription": "Extra characters that end the numerator when auto-fraction looks backward. Spaces, `$`, and opening brackets always end it. Write `\\t` for tab."
        },
        "latexSuite.autoFraction.excludedRegions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "open",
              "close"
            ],
            "properties": {
              "open": {
                "type": "string"
              },
              "close": {
                "type": "string"
              }
            }
          },
          "default": [
            {
              "open": "^{",
              "close": "}"
            },
            {
              "open": "\\pu{",
              "close": "}"
            }
          ],
          "scope": "resource",
          "order": 33,
          "markdownDescription": "Regions where typing `/` never creates a fraction, given as `open`/`close` pairs."
        },
        "latexSuite.matrixShortcuts.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "order": 40,
          "markdownDescription": "Inside matrix-like environments, `Tab` adds a cell, `Enter` starts a new row, and `Shift+Enter` leaves the environment."
        },
        "latexSuite.matrixShortcuts.environments": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "pmatrix",
            "cases",
            "align",
            "gather",
            "bmatrix",
            "Bmatrix",
            "vmatrix",
            "Vmatrix",
            "array",
            "matrix"
          ],
          "scope": "resource",
          "order": 41,
          "markdownDescription": "Environments where matrix shortcuts are active."
        },
        "latexSuite.matrixShortcuts.macros": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "eqalign"
          ],
          "scope": "resource",
          "order": 42,
          "markdownDescription": "Macros, such as `\\eqalign{...}`, where matrix shortcuts are active."
        },
        "latexSuite.tabOut.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "order": 50,
          "markdownDescription": "Use `Tab` to jump past closing brackets and out of equations."
        },
        "latexSuite.tabOut.closingSymbols": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            ")",
            "]",
            "\\rbrack",
            "\\}",
            "\\rbrace",
            "\\rangle",
            "\\rvert",
            "\\rVert",
            "\\rfloor",
            "\\rceil",
            "\\urcorner",
            "}"
          ],
          "scope": "resource",
          "order": 51,
          "markdownDescription": "Closing delimiters that `Tab` jumps past."
        },
        "latexSuite.tabOut.exitEquationOnlyAtEndOfLine": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "order": 52,
          "markdownDescription": "Only let `Tab` leave an equation when nothing but whitespace remains before its end."
        },
        "latexSuite.bracketEnlargement.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "order": 60,
          "markdownDescription": "When a snippet inserts a large operator such as `\\sum` inside brackets, change them to `\\left( ... \\right)`."
        },
        "latexSuite.bracketEnlargement.triggers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "\\sum",
            "\\int",
            "\\frac",
            "\\prod",
            "\\bigcup",
            "\\bigcap"
          ],
          "scope": "resource",
          "order": 61,
          "markdownDescription": "Commands whose insertion enlarges the surrounding brackets."
        },
        "latexSuite.bracketEnlargement.insertSpaces": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "order": 62,
          "markdownDescription": "Add a space just inside brackets after enlarging them."
        },
        "latexSuite.debug": {
          "type": "string",
          "enum": [
            "off",
            "info",
            "verbose"
          ],
          "default": "off",
          "scope": "resource",
          "order": 70,
          "markdownDescription": "Log snippet matching to the **LaTeX Suite** output channel.",
          "enumDescriptions": [
            "No logging.",
            "Log each snippet expansion.",
            "Log each expansion with its math mode and enclosing scopes."
          ]
        },
        "latexSuite.fileExtensions": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^\\.?[^./\\\\\\s]+$"
          },
          "uniqueItems": true,
          "default": [
            ".tex",
            ".md",
            ".qmd"
          ],
          "scope": "resource",
          "order": 2,
          "markdownDescription": "File extensions where LaTeX Suite typing shortcuts are active. Entries may include the leading dot and are matched without regard to case. Changes take effect immediately. Use an empty list to disable all file types. Untitled Markdown and LaTeX documents follow the `.md` and `.tex` entries."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out && node scripts/write-test-assets.js",
    "watch-tests": "node scripts/write-test-assets.js && npm-run-all -p watch-tests:*",
    "pretest": "npm run compile-tests && npm run compile",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test",
    "test:unit": "npm run compile-tests && mocha --ui tdd \"out/test/unit/**/*.test.js\"",
    "benchmark": "npm run compile-tests && node scripts/benchmark-context.js",
    "package:vsix": "vsce package --no-dependencies",
    "check:package": "node scripts/check-package.js",
    "test:vsix": "node scripts/test-vsix.js",
    "test:trust": "node scripts/test-vsix.js --restricted",
    "watch-tests:tsc": "tsc -p . -w --outDir out",
    "watch-tests:assets": "node scripts/write-test-assets.js --watch"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "1.137.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "4.0.0",
    "acorn": "^8.18.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "mocha": "^11.8.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "yauzl": "^3.4.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.1.2"
  }
}
